{
  "name": "estudos-matematicos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:pages": "ng build --base-href /estudos-matematicos/ && node scripts/preparar-pages.mjs",
    "gerar:icones": "node scripts/gerar-icones.mjs",
    "gerar:teorias": "node scripts/gerar-registro-teorias.mjs",
    "gerar:geradores": "node scripts/gerar-registro-geradores.mjs",
    "gerar:textos": "node scripts/gerar-catalogo-textos.mjs",
    "gerar:chaves": "node scripts/gerar-chaves-usadas.mjs",
    "test:cobertura": "ng test --watch=true --coverage",
    "verificar:geradores": "node scripts/verificar-geradores.mjs",
    "verificar:pwa": "npm run build:pages && node scripts/verificar-pwa.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "katex": "^0.19.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@types/katex": "^0.16.8",
    "@vitest/coverage-istanbul": "^5.0.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "sass": "^1.106.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
